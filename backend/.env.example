APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://manga-reader-tau-six.vercel.app

# MySQL / MariaDB Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mangaverse
DB_USER=mangaverse_user
DB_PASS=replace_with_strong_password

# Cloudflare R2 / S3 Object Storage
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mangaverse-chapters
R2_PUBLIC_URL=https://cdn.yourdomain.com

# Admin Security
ADMIN_API_KEY=mv_adm_secret_key_change_in_production
RATE_LIMIT_PER_MINUTE=120
