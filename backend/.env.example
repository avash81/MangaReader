APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ─── MySQL / MariaDB (cPanel MySQL settings) ───────────────────
# Found in cPanel → MySQL Databases
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpanelusername_mangaverse
DB_USER=cpanelusername_mangauser
DB_PASS=replace_with_strong_password

# ─── Cloudflare R2 (Optional CDN for chapter images / PDFs) ───
# Free 10GB: cloudflare.com/products/r2
STORAGE_DRIVER=local          # 'local' = store in /public_html/storage/ (cPanel), 'r2' = Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mangaverse-chapters
R2_PUBLIC_URL=https://cdn.yourdomain.com

# ─── Admin & Auth Security ─────────────────────────────────────
ADMIN_API_KEY=mv_adm_CHANGE_THIS_TO_SOMETHING_LONG_AND_RANDOM
JWT_SECRET=mv_jwt_CHANGE_THIS_TO_SOMETHING_LONG_AND_RANDOM
RATE_LIMIT_PER_MINUTE=120

# ─── Push Notifications (Firebase Cloud Messaging) ─────────────
FCM_SERVER_KEY=

# ─── cPanel Cron Schedule Reference ───────────────────────────
# Every 2 hours: 0 */2 * * * /usr/local/bin/php /home/USERNAME/public_html/backend/cron/sync_chapters.php >> /home/USERNAME/logs/sync.log 2>&1
# Daily 04:00:   0 4 * * * /usr/local/bin/php /home/USERNAME/public_html/backend/cron/generate_sitemap.php >> /home/USERNAME/logs/sitemap.log 2>&1
# Every 6 hours: 0 */6 * * * /usr/local/bin/php /home/USERNAME/public_html/backend/cron/discover.php >> /home/USERNAME/logs/discover.log 2>&1
# Every 5 mins:  */5 * * * * /usr/local/bin/php /home/USERNAME/public_html/backend/cron/publish.php >> /home/USERNAME/logs/publish.log 2>&1
